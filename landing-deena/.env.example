# Porta do servidor
PORT=3000

# Meta Pixel (ViewContent · InitiateCheckout · Purchase · ContatoEscritorioParceiro)
META_PIXEL_ID=

# URL de embed do VSL (YouTube/Vimeo/Panda). Ex.: https://player.vimeo.com/video/000000
VSL_EMBED_URL=

# Links de checkout do gateway (cartão de crédito) — um por plano.
# O cliente preenche os dados na landing e é redirecionado para o ambiente seguro do gateway.
# Configure a URL de retorno do gateway para: https://SEU-DOMINIO/obrigado?plano=<id>
CHECKOUT_URL_ESSENCIAL=
CHECKOUT_URL_ESTRATEGICO=
CHECKOUT_URL_PREMIUM=

# Webhook opcional (n8n, Kommo, Zapier...) para receber leads, pedidos e contadores
LEAD_WEBHOOK_URL=

# WhatsApp comercial do sistema (somente números, com DDI). Ex.: 5586999999999
WHATSAPP_NUMERO=
